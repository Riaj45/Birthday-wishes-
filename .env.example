# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Administrator authentication (verified strictly server-side; never exposed to client).
# Override these in your production environment secrets.
ADMIN_USERNAME="MY_ADMIN_USERNAME"
ADMIN_PASSWORD="MY_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
